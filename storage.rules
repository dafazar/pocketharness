rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Avatar pengguna — hanya pemilik yang bisa upload/read
    match /avatars/{uid}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024   // Max 2 MB
        && request.resource.contentType.matches('image/.*');
    }

    // Asset premium — semua user login bisa baca, tidak ada yang bisa upload
    match /premium_assets/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Semua path lain: deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
